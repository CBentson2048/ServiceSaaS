{
  "name": "@sheer/ui-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Shared React Native UI primitives for Sheer mobile apps.",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/cjs/index.js"
    }
  },
  "files": ["dist/"],
  "scripts": {
    "build": "pnpm run build:cjs && pnpm run build:esm && pnpm run build:esm:pkg",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:esm:pkg": "node -e \"require('fs').writeFileSync('dist/esm/package.json', JSON.stringify({type:'module'},null,2))\"",
    "dev": "tsc -p tsconfig.cjs.json --watch",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@sheer/design-tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.83.0",
    "react-native-safe-area-context": ">=5.0.0"
  },
  "devDependencies": {
    "@sheer/config": "workspace:*",
    "@types/react": "~19.2.14",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "rimraf": "^5.0.10",
    "typescript": "^5.5.4"
  }
}
