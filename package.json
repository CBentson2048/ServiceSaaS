{
  "name": "sheer-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Sheer Platform monorepo - multi-location salon operations platform.",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "sheer-lab:ios": "pnpm --filter @sheer/sheer-lab ios",
    "sheer-lab:android": "pnpm --filter @sheer/sheer-lab android",
    "sheer-lab:start": "pnpm --filter @sheer/sheer-lab start",
    "sheer-lab:typecheck": "pnpm --filter @sheer/sheer-lab typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .gitignore",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "prettier": "^3.3.3",
    "rimraf": "^5.0.10",
    "turbo": "^2.1.3",
    "typescript": "^5.5.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "esbuild"
    ],
    "overrides": {
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3"
    }
  }
}
