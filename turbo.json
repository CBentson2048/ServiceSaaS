{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [".env", "tsconfig.base.json"],
  "globalEnv": [
    "NODE_ENV",
    "VITE_API_URL",
    "VITE_SUPABASE_URL",
    "VITE_SUPABASE_ANON_KEY",
    "VITE_STRIPE_PUBLISHABLE_KEY",
    "VITE_SHEER_APP_DEEP_LINK",
    "VITE_SHEER_APP_IOS_URL",
    "VITE_SHEER_APP_ANDROID_URL",
    "VITE_SHEER_APP_GENERIC_URL",
    "SHEER_LAB_API_URL",
    "SHEER_LAB_ENV",
    "SHEER_LAB_IOS_BUNDLE_ID",
    "SHEER_LAB_ANDROID_PACKAGE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
