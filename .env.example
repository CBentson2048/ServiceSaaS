# Root-level shared env example.
# Each app also has its own .env.example in apps/<app>/.env.example.

NODE_ENV=development

# Shared service credentials (used in dev/staging/prod envs)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Twilio WhatsApp — booking confirmations & reminders. When unset, the API logs
# messages instead of delivering (log-only mode).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=+14155238886

# Background notification dispatcher (optional overrides; sensible defaults applied).
# COMMS_DISPATCH_ENABLED=true
# COMMS_DISPATCH_INTERVAL_MS=60000
# COMMS_DISPATCH_BATCH_SIZE=25
# COMMS_DISPATCH_MAX_ATTEMPTS=3
