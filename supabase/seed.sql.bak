-- ---------------------------------------------------------------------------
-- Core: profiles + memberships (auth user ids resolved by email)
-- ---------------------------------------------------------------------------
INSERT INTO core.user_profiles (id, full_name, display_name, email)
SELECT u.id, v.full_name, v.display_name, u.email::citext
FROM (VALUES
  ('owner@sheer.local'::text, 'Luke Ormsby', 'Luke'),
  ('manager.alpha@sheer.local', 'Manager Alpha', 'Manager Alpha'),
  ('manager.beta@sheer.local', 'Manager Beta', 'Manager Beta'),
  ('stylist.alpha@sheer.local', 'Stylist Alpha', 'Stylist Alpha'),
  ('stylist.beta@sheer.local', 'Stylist Beta', 'Stylist Beta'),
  ('client.alice@sheer.local', 'Alice Carter', 'Alice'),
  ('client.bob@sheer.local', 'Bob Morgan', 'Bob')
) AS v(email, full_name, display_name)
JOIN auth.users u ON lower(u.email) = lower(v.email)
ON CONFLICT (id) DO UPDATE SET
  full_name = excluded.full_name,
  display_name = excluded.display_name,
  email = excluded.email;

