-- =============================================================================
-- Sheer Platform — deterministic RLS + workflow fixture (local / staging)
-- =============================================================================
-- Business: Luke Ormsby Hair (slug luke-ormsby-hair-seed)
-- Locations: Chelsea, Soho, Clapham, Richmond
-- Auth users (emails) must exist BEFORE this seed runs:
--   owner@sheer.local, manager.alpha@sheer.local, manager.beta@sheer.local,
--   stylist.alpha@sheer.local, stylist.beta@sheer.local,
--   client.alice@sheer.local, client.bob@sheer.local
--
-- Create auth users first:
--   pnpm --filter @sheer/api create-test-users
--
-- Then apply this file (e.g. supabase db reset runs migrations + this seed).
-- Re-seed: deletes this fixture business by slug (CASCADE) then re-inserts.
-- =============================================================================

DO $$
BEGIN
  IF (
    SELECT COUNT(*)::int
    FROM auth.users
    WHERE lower(email) IN (
      'owner@sheer.local',
      'manager.alpha@sheer.local',
      'manager.beta@sheer.local',
      'stylist.alpha@sheer.local',
      'stylist.beta@sheer.local',
      'client.alice@sheer.local',
      'client.bob@sheer.local'
    )
  ) <> 7 THEN
    RAISE EXCEPTION
      'Seed requires 7 auth users. Run: pnpm --filter @sheer/api create-test-users (see database/seeds/README.md).';
  END IF;
END $$;

BEGIN;

DELETE FROM core.businesses WHERE slug = 'luke-ormsby-hair-seed';

