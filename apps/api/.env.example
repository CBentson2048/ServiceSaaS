# Local: development | Staging/preview deploys (e.g. Railway): staging | Production: production
NODE_ENV=development
# Local default; Railway and most hosts set PORT automatically—omit or override locally only.
PORT=3001

# Frontend origin(s) allowed to call the API. Comma-separated. For shared dev/staging URLs,
# include every demo origin (e.g. https://your-app.vercel.app, http://localhost:5173).
CORS_ORIGINS=http://localhost:5173

# Database / Supabase
# DATABASE_URL=postgres://user:pass@localhost:5432/sheer
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Auth
# JWT_SECRET=
# JWT_EXPIRES_IN=1d

# Email (Resend)
# Get an API key at https://resend.com → API Keys.
# Without RESEND_API_KEY, the API still creates invitations / password-reset
# tokens and returns the URL; emails are logged instead of sent (handy for
# local development).
# RESEND_API_KEY=
# RFC 5322 sender on a verified Resend domain. Defaults to `Sheer <onboarding@resend.dev>`,
# which is restricted to the address that owns the Resend account.
# Use either RESEND_FROM_EMAIL (preferred, may include a display name) or
# RESEND_FROM (bare email; the API will wrap it as "QLOOQO <addr>"). If both
# are set, RESEND_FROM_EMAIL wins.
# RESEND_FROM_EMAIL=QLOOQO <team@yourdomain.com>
# RESEND_FROM=noreply@yourdomain.com
# Resend (Svix) webhook signing secret for the email delivery/bounce webhook at
# POST /api/email/status. Configure the endpoint in the Resend dashboard (Webhooks) and paste the
# signing secret here. A hard bounce on this webhook escalates the notification to the next channel
# in the chain (email is last for a WhatsApp-first client, so usually there is none). When unset
# the webhook rejects all requests (the email channel still sends; it just won't advance past `sent`).
# RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
# Base URL for the staff invitation accept page. Defaults to the first CORS_ORIGINS entry.
# STAFF_INVITE_BASE_URL=http://localhost:5173
# Base URL the password-reset email links to. Defaults to the first CORS_ORIGINS entry.
# In prod set this to your web origin (e.g. https://sheer-platform-web.vercel.app).
# PASSWORD_RESET_BASE_URL=http://localhost:5173

# --- (Optional) Supabase Auth SMTP routed through Resend ---
# We do NOT use Supabase's built-in recovery email today; password reset is
# implemented as a custom token flow + Resend (see docs/architecture/password-reset.md).
# If you decide to also relay Supabase's own auth emails through Resend, set
# these in the Supabase dashboard (NOT in this .env file):
#   SMTP host     = smtp.resend.com
#   SMTP port     = 465 (SSL) or 587 (STARTTLS)
#   SMTP username = resend
#   SMTP password = <RESEND_API_KEY>
#   Sender email  = noreply@<your-verified-domain>
# And add to the Auth → URL Configuration allowlist:
#   https://<web-origin>/auth/reset-password
#   http://localhost:5173/auth/reset-password

# Stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Twilio WhatsApp — booking confirmations & reminders.
# When ACCOUNT_SID/AUTH_TOKEN and a sender (Messaging Service or From) are unset, the API runs
# in log-only mode: messages are logged, never delivered, and the message log records the truth.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# Sender: prefer a Messaging Service (sender pool + compliance) for both WhatsApp and SMS.
# Falls back to single From numbers per channel.
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_WHATSAPP_FROM=+14155238886       # e.g. Twilio sandbox; `whatsapp:` prefix added automatically
# TWILIO_SMS_FROM=+441234567890           # SMS sender: first fallback when WhatsApp fails, is ineligible, or is opted out
#
# Default country calling code (digits only) used to convert national-format client numbers
# (e.g. UK "07700900123") to E.164 for WhatsApp/SMS. Without it such numbers are treated as invalid.
# DEFAULT_PHONE_COUNTRY_CALLING_CODE=44
#
# Approved Content template SIDs (HXxx...). Production sends use these + ContentVariables, NOT
# freeform message bodies. When a template SID is absent the API falls back to a freeform body,
# which WhatsApp REJECTS for business-initiated messages outside the 24h session window (Twilio
# error 63016 "Outside messaging window. Use a Message Template instead") — i.e. confirmations and
# reminders silently fail to deliver. Useful only with the Twilio sandbox in dev.
# IMPORTANT: these must also be set in the deployed environment (Railway does NOT read this .env).
# Templates must reference variables {{1}}..{{5}}:
#   {{1}} client first name  {{2}} location name  {{3}} service(s)  {{4}} stylist  {{5}} date & time
#
# Current approved Content template SIDs (from the Sheer Twilio console — these are template IDs,
# not secrets). Either naming convention below works; the *_CONTENT_SID form takes priority.
TWILIO_WHATSAPP_CONFIRMATION_CONTENT_SID=HXced56659866eb697bb2c90813772d72a
# 2-hour reminder (Wrike #4507281442). No Content template exists yet — create + approve one in the
# Twilio console (same 5 variables as the 24h/48h reminders: {{1}} client, {{2}} location, {{3}}
# service(s), {{4}} stylist, {{5}} date & time), then paste its HX… SID here and in each deployed env.
TWILIO_WHATSAPP_REMINDER_2H_CONTENT_SID=HXc638bfdcdd3677a358b62143c6058cd4
TWILIO_WHATSAPP_REMINDER_24H_CONTENT_SID=HXa6a031656db8bf253ebef2d772518800
TWILIO_WHATSAPP_REMINDER_48H_CONTENT_SID=HX39560d2734cc3a520dbc36eb082e3db2
TWILIO_WHATSAPP_REMINDER_1W_CONTENT_SID=HXb0299351b0e74d2239734b4e671ce945
# Rebooking nudge (Wrike #4507281502). Re-engagement message → WhatsApp MARKETING category.
# Template body references {{1}} client first name, {{2}} location name, {{3}} service(s).
TWILIO_WHATSAPP_REBOOKING_NUDGE_CONTENT_SID=HX06ffe7f4a6c14f9284b111cbd111a602
# Legacy alias names also accepted (used only if the *_CONTENT_SID form above is unset):
# TWILIO_TEMPLATE_BOOKING_CONFIRMATION_SID=HXced56659866eb697bb2c90813772d72a
# TWILIO_TEMPLATE_BOOKING_REMINDER_24H_SID=HXa6a031656db8bf253ebef2d772518800
# TWILIO_TEMPLATE_BOOKING_REMINDER_48H_SID=HX39560d2734cc3a520dbc36eb082e3db2
# TWILIO_TEMPLATE_BOOKING_REMINDER_1W_SID=HXb0299351b0e74d2239734b4e671ce945
#
# Delivery-status & inbound webhooks. Set STATUS_CALLBACK to a public URL Twilio can reach.
# Both endpoints verify the X-Twilio-Signature using TWILIO_AUTH_TOKEN.
# The INBOUND endpoint is also how a client's STOP/UNSUBSCRIBE reply becomes a recorded per-channel
# opt-out (comms.channel_opt_outs, 0098). Without it configured in the Twilio console, the carrier
# still honours STOP but we keep queueing messages it will silently drop.
# TWILIO_STATUS_CALLBACK_URL=https://api.yourdomain.com/api/twilio/messaging/status
# TWILIO_INBOUND_CALLBACK_URL=https://api.yourdomain.com/api/twilio/messaging/inbound

# Background notification dispatcher (optional overrides; sensible defaults applied).
# COMMS_DISPATCH_ENABLED=true             # default; set false in tests/CI
# COMMS_DISPATCH_INTERVAL_MS=60000        # default (clamped 5000–3600000)
# COMMS_DISPATCH_BATCH_SIZE=25            # default (clamped 1–200)
# COMMS_DISPATCH_MAX_ATTEMPTS=3           # default (clamped 1–10)
# COMMS_DISPATCH_MAX_DRAIN_BATCHES=20     # default (clamped 1–1000); downtime catch-up per tick

# Automatic message-usage accounting recovery (0108). Repairs ledger gaps for
# messages a provider already accepted. It NEVER sends anything.
# MESSAGE_USAGE_RECOVERY_ENABLED=true          # default; set false in tests/CI
# MESSAGE_USAGE_RECOVERY_INTERVAL_MS=900000    # default (clamped 60000–3600000)
# MESSAGE_USAGE_RECOVERY_BATCH_SIZE=200        # default (clamped 1–1000); bounds MISSING entries
# MESSAGE_USAGE_RECOVERY_MAX_DRAIN_BATCHES=5   # default (clamped 1–100)
# MESSAGE_USAGE_RECOVERY_GRACE_SECONDS=300     # default (clamped 0–86400); don't race the dispatcher

# HTTP body logging. LOCAL DEVELOPMENT ONLY — leave unset in every deployed
# environment. Request/response bodies carry client and staff personal data
# (names, emails, phones, and free-text notes that often contain health
# information); logs have a different access model and retention period from the
# database and sit outside subject-access/erasure processes. When enabled,
# credential and personal-data keys are still redacted, and /api/zac and
# /api/payroll bodies stay suppressed. Defaults off.
# LOG_HTTP_BODIES=true

# ---------------------------------------------------------------------------
# ZAC — the intelligence layer
# ---------------------------------------------------------------------------
# Feature switch. ZAC is dark until this is true; /api/zac then 404s.
# ZAC_ENABLED=true
# Optional canary allowlist (comma-separated business ids). Unset = every
# business with the feature enabled.
# ZAC_ALLOWED_BUSINESS_IDS=

# THE PROVIDER KEY IS THE PRODUCT SWITCH. With no key ZAC falls back to the
# deterministic stub: it cannot narrate answers and cannot route semantically,
# so general/hypothetical questions degrade to an honest "my reasoning is
# offline" and natural paraphrases route on keyword rules alone (~66% accurate
# on unseen phrasing). /api/zac/health reports `uat_ready: false` in that
# state — a deployment must NOT be handed to the client while it does.
# ANTHROPIC_API_KEY=

# The narration model (answers). Defaults to claude-opus-5.
# ZAC_MODEL_ID=claude-opus-5
# ZAC_MODEL_MAX_TOKENS=8192

# The semantic ROUTING model — smaller/cheaper than the narration model, since
# routing is a small, high-volume classification on the user's critical path.
# The routing prompt is ~2.1k tokens and byte-identical every call, so it is
# CACHED: the default is chosen for a cacheable-prefix minimum below that size.
# If you override this, verify cache_read_input_tokens on zac.cost_events is
# non-zero — a model with a higher minimum silently stops caching.
# ZAC_ROUTER_MODEL_ID=claude-sonnet-5

# Kill switch for Layer 2 semantic routing. Default ON. Setting this false
# forces the pre-semantic deterministic path — an incident lever, not a
# steady state: it reintroduces the keyword-routing behaviour that failed
# client acceptance.
# ZAC_SEMANTIC_ROUTER_ENABLED=true

# Deploy-time model prices for the cost spine (USD per million tokens). When
# unset, zac.cost_events estimates are null or understated.
# ZAC_PRICE_INPUT_USD_PER_MTOK=
# ZAC_PRICE_OUTPUT_USD_PER_MTOK=
# ZAC_PRICE_CACHE_READ_USD_PER_MTOK=
# ZAC_PRICE_CACHE_WRITE_USD_PER_MTOK=

# Prices for the semantic ROUTING model, which is a different (cheaper) model
# from the narration one. Without these, classification cost events are priced
# at the narration model's rates and routing spend is overstated. The API logs
# a warning at startup when the router model differs and these are unset.
# ZAC_ROUTER_PRICE_INPUT_USD_PER_MTOK=
# ZAC_ROUTER_PRICE_OUTPUT_USD_PER_MTOK=
# ZAC_ROUTER_PRICE_CACHE_READ_USD_PER_MTOK=
# ZAC_ROUTER_PRICE_CACHE_WRITE_USD_PER_MTOK=

# ---------------------------------------------------------------------------
# ZAC semantic-routing migration (OpenAI structured semantic router)
# ---------------------------------------------------------------------------

# Which routing pipeline is AUTHORITATIVE for meaning. Cutover order:
#   legacy   (default) current production behaviour; the dedicated semantic
#            provider is not even constructed.
#   shadow   legacy still decides every turn; the OpenAI router classifies the
#            same turns in parallel and both verdicts land on the telemetry
#            spine (zac.spine.shadow_classification) for disagreement review.
#            Observation only — the shadow verdict can never affect a turn.
#   semantic the OpenAI router is Layer 2. Deterministic explicit directives
#            (Layer 1) and the safe fallback ladder (Layer 3) are unchanged.
# ZAC_ROUTING_MODE=legacy

# The dedicated semantic provider. Only 'openai' exists today; the seam is
# provider-shaped so an AnthropicSemanticProvider can slot in later without
# orchestration changes.
# ZAC_SEMANTIC_PROVIDER=openai

# THE KEY IS THE SWITCH, mirroring ANTHROPIC_API_KEY: without it, shadow and
# semantic modes run without a dedicated router (and say so in the logs and
# /zac/health) rather than failing the boot.
# OPENAI_API_KEY=

# The classification model. The default is provisional until the live
# benchmark has been run against the account's real models:
#   ZAC_EVAL_MODELS=gpt-5-mini,gpt-5-nano pnpm --filter @sheer/api zac-routing-eval
# Choose the cheapest model that passes the routing quality gates.
# ZAC_SEMANTIC_MODEL=gpt-5-mini

# Reasoning effort for reasoning-capable classification models. 'minimal'
# keeps routing off the user's critical path; only raise it with benchmark
# evidence. Ignored (not sent) for models that reject the parameter.
# ZAC_SEMANTIC_REASONING_EFFORT=minimal

# Prices for the DEDICATED semantic provider (USD per million tokens). No
# fallback to the Anthropic prices — a different vendor's rates would be a
# fabrication, so unpriced deployments estimate $0 and warn at startup.
# ZAC_SEMANTIC_PRICE_INPUT_USD_PER_MTOK=
# ZAC_SEMANTIC_PRICE_OUTPUT_USD_PER_MTOK=
# ZAC_SEMANTIC_PRICE_CACHE_READ_USD_PER_MTOK=

# ---------------------------------------------------------------------------
# In-app notification push delivery (Expo)
# ---------------------------------------------------------------------------
# Push is a delivery channel on top of the in-app notification, never its source
# of truth. With everything below unset the defaults apply; with push disabled
# the arrival alert still appears in the stylist app.
#
# PUSH_DISPATCH_ENABLED=false        # stop draining the outbox (in-app unaffected)
# PUSH_DISPATCH_INTERVAL_MS=15000    # clamped 5000-600000
# PUSH_DISPATCH_BATCH_SIZE=50        # capped at Expo's 100-message request limit
# PUSH_DISPATCH_MAX_ATTEMPTS=3
# PUSH_DISPATCH_MAX_DRAIN_BATCHES=20
# EXPO_PUSH_ENABLED=false            # turn the Expo transport off entirely
# EXPO_PUSH_TIMEOUT_MS=10000         # clamped 1000-60000
# Only required if the Expo project enables enhanced security for push:
# EXPO_ACCESS_TOKEN=
