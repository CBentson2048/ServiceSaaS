# Local: development | Staging/preview deploys (e.g. Railway): staging | Production: production
NODE_ENV=development
# Local default; Railway and most hosts set PORT automatically—omit or override locally only.
PORT=3001

# Frontend origin(s) allowed to call the API. Comma-separated. For shared dev/staging URLs,
# include every demo origin (e.g. https://your-app.vercel.app, http://localhost:5173).
CORS_ORIGINS=http://localhost:5173

# Database / Supabase
# DATABASE_URL=postgres://user:pass@localhost:5432/sheer
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Auth
# JWT_SECRET=
# JWT_EXPIRES_IN=1d

# Email (Resend)
# Get an API key at https://resend.com → API Keys.
# Without RESEND_API_KEY, the API still creates invitations / password-reset
# tokens and returns the URL; emails are logged instead of sent (handy for
# local development).
# RESEND_API_KEY=
# RFC 5322 sender on a verified Resend domain. Defaults to `Sheer <onboarding@resend.dev>`,
# which is restricted to the address that owns the Resend account.
# Use either RESEND_FROM_EMAIL (preferred, may include a display name) or
# RESEND_FROM (bare email; the API will wrap it as "Sheer <addr>"). If both
# are set, RESEND_FROM_EMAIL wins.
# RESEND_FROM_EMAIL=Sheer <team@yourdomain.com>
# RESEND_FROM=noreply@yourdomain.com
# Base URL for the staff invitation accept page. Defaults to the first CORS_ORIGINS entry.
# STAFF_INVITE_BASE_URL=http://localhost:5173
# Base URL the password-reset email links to. Defaults to the first CORS_ORIGINS entry.
# In prod set this to your web origin (e.g. https://sheer-platform-web.vercel.app).
# PASSWORD_RESET_BASE_URL=http://localhost:5173

# --- (Optional) Supabase Auth SMTP routed through Resend ---
# We do NOT use Supabase's built-in recovery email today; password reset is
# implemented as a custom token flow + Resend (see docs/architecture/password-reset.md).
# If you decide to also relay Supabase's own auth emails through Resend, set
# these in the Supabase dashboard (NOT in this .env file):
#   SMTP host     = smtp.resend.com
#   SMTP port     = 465 (SSL) or 587 (STARTTLS)
#   SMTP username = resend
#   SMTP password = <RESEND_API_KEY>
#   Sender email  = noreply@<your-verified-domain>
# And add to the Auth → URL Configuration allowlist:
#   https://<web-origin>/auth/reset-password
#   http://localhost:5173/auth/reset-password

# Stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
