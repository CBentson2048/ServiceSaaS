# Local: development | Staging/preview deploys (e.g. Railway): staging | Production: production
NODE_ENV=development
# Local default; Railway and most hosts set PORT automatically—omit or override locally only.
PORT=3001

# Frontend origin(s) allowed to call the API. Comma-separated. For shared dev/staging URLs,
# include every demo origin (e.g. https://your-app.vercel.app, http://localhost:5173).
CORS_ORIGINS=http://localhost:5173

# Database / Supabase
# DATABASE_URL=postgres://user:pass@localhost:5432/sheer
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Auth
# JWT_SECRET=
# JWT_EXPIRES_IN=1d

# Email (Resend)
# Get an API key at https://resend.com → API Keys.
# Without RESEND_API_KEY, the API still creates invitations / password-reset
# tokens and returns the URL; emails are logged instead of sent (handy for
# local development).
# RESEND_API_KEY=
# RFC 5322 sender on a verified Resend domain. Defaults to `Sheer <onboarding@resend.dev>`,
# which is restricted to the address that owns the Resend account.
# Use either RESEND_FROM_EMAIL (preferred, may include a display name) or
# RESEND_FROM (bare email; the API will wrap it as "QLOOQO <addr>"). If both
# are set, RESEND_FROM_EMAIL wins.
# RESEND_FROM_EMAIL=QLOOQO <team@yourdomain.com>
# RESEND_FROM=noreply@yourdomain.com
# Resend (Svix) webhook signing secret for the email delivery/bounce webhook at
# POST /api/email/status. Configure the endpoint in the Resend dashboard (Webhooks) and paste the
# signing secret here. A hard bounce on this webhook escalates the notification to SMS. When unset
# the webhook rejects all requests (the email channel still sends; it just won't advance past `sent`).
# RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
# Base URL for the staff invitation accept page. Defaults to the first CORS_ORIGINS entry.
# STAFF_INVITE_BASE_URL=http://localhost:5173
# Base URL the password-reset email links to. Defaults to the first CORS_ORIGINS entry.
# In prod set this to your web origin (e.g. https://sheer-platform-web.vercel.app).
# PASSWORD_RESET_BASE_URL=http://localhost:5173

# --- (Optional) Supabase Auth SMTP routed through Resend ---
# We do NOT use Supabase's built-in recovery email today; password reset is
# implemented as a custom token flow + Resend (see docs/architecture/password-reset.md).
# If you decide to also relay Supabase's own auth emails through Resend, set
# these in the Supabase dashboard (NOT in this .env file):
#   SMTP host     = smtp.resend.com
#   SMTP port     = 465 (SSL) or 587 (STARTTLS)
#   SMTP username = resend
#   SMTP password = <RESEND_API_KEY>
#   Sender email  = noreply@<your-verified-domain>
# And add to the Auth → URL Configuration allowlist:
#   https://<web-origin>/auth/reset-password
#   http://localhost:5173/auth/reset-password

# Stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Twilio WhatsApp — booking confirmations & reminders.
# When ACCOUNT_SID/AUTH_TOKEN and a sender (Messaging Service or From) are unset, the API runs
# in log-only mode: messages are logged, never delivered, and the message log records the truth.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# Sender: prefer a Messaging Service (sender pool + compliance) for both WhatsApp and SMS.
# Falls back to single From numbers per channel.
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_WHATSAPP_FROM=+14155238886       # e.g. Twilio sandbox; `whatsapp:` prefix added automatically
# TWILIO_SMS_FROM=+441234567890           # SMS sender used for fallback when WhatsApp fails/ineligible
#
# Default country calling code (digits only) used to convert national-format client numbers
# (e.g. UK "07700900123") to E.164 for WhatsApp/SMS. Without it such numbers are treated as invalid.
# DEFAULT_PHONE_COUNTRY_CALLING_CODE=44
#
# Approved Content template SIDs (HXxx...). Production sends use these + ContentVariables, NOT
# freeform message bodies. When a template SID is absent the API falls back to a freeform body,
# which WhatsApp REJECTS for business-initiated messages outside the 24h session window (Twilio
# error 63016 "Outside messaging window. Use a Message Template instead") — i.e. confirmations and
# reminders silently fail to deliver. Useful only with the Twilio sandbox in dev.
# IMPORTANT: these must also be set in the deployed environment (Railway does NOT read this .env).
# Templates must reference variables {{1}}..{{5}}:
#   {{1}} client first name  {{2}} location name  {{3}} service(s)  {{4}} stylist  {{5}} date & time
#
# Current approved Content template SIDs (from the Sheer Twilio console — these are template IDs,
# not secrets). Either naming convention below works; the *_CONTENT_SID form takes priority.
TWILIO_WHATSAPP_CONFIRMATION_CONTENT_SID=HXced56659866eb697bb2c90813772d72a
TWILIO_WHATSAPP_REMINDER_24H_CONTENT_SID=HXa6a031656db8bf253ebef2d772518800
TWILIO_WHATSAPP_REMINDER_48H_CONTENT_SID=HX39560d2734cc3a520dbc36eb082e3db2
TWILIO_WHATSAPP_REMINDER_1W_CONTENT_SID=HXb0299351b0e74d2239734b4e671ce945
# Legacy alias names also accepted (used only if the *_CONTENT_SID form above is unset):
# TWILIO_TEMPLATE_BOOKING_CONFIRMATION_SID=HXced56659866eb697bb2c90813772d72a
# TWILIO_TEMPLATE_BOOKING_REMINDER_24H_SID=HXa6a031656db8bf253ebef2d772518800
# TWILIO_TEMPLATE_BOOKING_REMINDER_48H_SID=HX39560d2734cc3a520dbc36eb082e3db2
# TWILIO_TEMPLATE_BOOKING_REMINDER_1W_SID=HXb0299351b0e74d2239734b4e671ce945
#
# Delivery-status & inbound webhooks. Set STATUS_CALLBACK to a public URL Twilio can reach.
# Both endpoints verify the X-Twilio-Signature using TWILIO_AUTH_TOKEN.
# TWILIO_STATUS_CALLBACK_URL=https://api.yourdomain.com/api/twilio/messaging/status
# TWILIO_INBOUND_CALLBACK_URL=https://api.yourdomain.com/api/twilio/messaging/inbound

# Background notification dispatcher (optional overrides; sensible defaults applied).
# COMMS_DISPATCH_ENABLED=true             # default; set false in tests/CI
# COMMS_DISPATCH_INTERVAL_MS=60000        # default (clamped 5000–3600000)
# COMMS_DISPATCH_BATCH_SIZE=25            # default (clamped 1–200)
# COMMS_DISPATCH_MAX_ATTEMPTS=3           # default (clamped 1–10)
# COMMS_DISPATCH_MAX_DRAIN_BATCHES=20     # default (clamped 1–1000); downtime catch-up per tick
