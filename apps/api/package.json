{
  "name": "@sheer/api",
  "version": "0.1.0",
  "private": true,
  "description": "Sheer Platform backend API (NestJS).",
  "main": "dist/main.js",
  "scripts": {
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "build": "nest build",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "backfill-bills": "ts-node --transpile-only scripts/backfill-bills.ts",
    "create-test-users": "ts-node --transpile-only scripts/create-test-users.ts",
    "seed-loh-pay-template": "ts-node --transpile-only scripts/seed-loh-pay-template.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@sheer/auth": "workspace:*",
    "@sheer/booking-core": "workspace:*",
    "@sheer/domain": "workspace:*",
    "@sheer/lab-core": "workspace:*",
    "@sheer/types": "workspace:*",
    "@supabase/supabase-js": "^2.49.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "libphonenumber-js": "^1.13.7",
    "pdfkit": "^0.19.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.12.2",
    "rxjs": "^7.8.1",
    "stripe": "^22.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.2.2",
    "@nestjs/testing": "^10.4.4",
    "@sheer/config": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.14.10",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "dotenv": "^16.4.7",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "jest": "^29.7.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4"
  }
