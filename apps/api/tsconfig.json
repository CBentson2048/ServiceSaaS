{
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ES2022",
    "lib": ["ES2022"],
    "moduleResolution": "Node",
    "declaration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": true,
    "incremental": true,
    "sourceMap": true,
    "removeComments": true,
    "baseUrl": "./",
    "paths": {
      "@sheer/auth": ["../../packages/auth/src/index.ts"],
      "@sheer/booking-core": ["../../packages/booking-core/src/index.ts"],
      "@sheer/design-tokens": ["../../packages/design-tokens/src/index.ts"],
      "@sheer/domain": ["../../packages/domain/src/index.ts"],
      "@sheer/lab-core": ["../../packages/lab-core/src/index.ts"]
    },
    "outDir": "./dist",
    "types": ["node", "jest"]
  },
  "include": ["src/**/*", "test/**/*", "scripts/**/*"],
  "exclude": ["node_modules", "dist"]
}
