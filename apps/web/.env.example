# Vite env vars must be prefixed with VITE_ to be exposed to the client bundle.
# Local: point at the Nest API. Deployed: use your Railway public URL, e.g. https://your-api.up.railway.app
# (no trailing slash; the app should append paths like /api/... as needed).
VITE_API_URL=http://localhost:3001

# Vercel: set VITE_API_URL in Project → Settings → Environment Variables for Production / Preview.
# Railway API: set CORS_ORIGINS to include your Vercel URL(s), e.g. https://your-app.vercel.app

# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# VITE_STRIPE_PUBLISHABLE_KEY=

# Optional: post-account-creation / Sheer App CTAs (see apps/web/src/config/mobileApp.ts).
# Vercel: add these to Project → Environment Variables if you override defaults.
# VITE_SHEER_APP_DEEP_LINK=
# VITE_SHEER_APP_IOS_URL=
# VITE_SHEER_APP_ANDROID_URL=
# VITE_SHEER_APP_GENERIC_URL=

# ZAC semantic-routing inspector (UAT / developer visibility). Shows, under
# each ZAC answer, which request mode / analysis intent the backend actually
# routed the turn to, and whether the OpenAI semantic router or the fallback
# decided it. Presentation only — the metadata is already in the /zac/ask
# response. Unset: visible on the Vite dev server, hidden in production
# builds. Set true on UAT/staging deployments; testers on a production build
# can set localStorage['zac.routing_debug']='true' instead.
# VITE_ZAC_SHOW_ROUTING_DEBUG=true

# QLOOQO 10 reports — foundation preview (Week 8 Ticket A). Exactly `true` shows
# the not-yet-released reports in the sidebar for testing. Baked in at build.
# Dev-test only: scope it to that Vercel environment, never Production. Pair with
# the API's REPORTS_FOUNDATION_SHELL. Unset: only released reports appear.
# VITE_REPORTS_FOUNDATION_SHELL=true
