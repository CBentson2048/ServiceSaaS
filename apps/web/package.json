{
  "name": "@sheer/web",
  "version": "0.1.0",
  "private": true,
  "description": "Sheer Platform web dashboard (Vite + React + TypeScript).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "pnpm --filter \"@sheer/types\" --filter \"@sheer/utils\" --filter \"@sheer/domain\" --filter \"@sheer/design-tokens\" run build",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "jest --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sheer/design-tokens": "workspace:*",
    "@sheer/domain": "workspace:*",
    "@sheer/types": "workspace:*",
    "@sheer/utils": "workspace:*",
    "@stripe/react-stripe-js": "^6.3.0",
    "@stripe/stripe-js": "^9.4.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@sheer/config": "workspace:*",
    "@types/node": "^20.14.10",
    "@types/react": "~19.2.14",
    "@types/react-dom": "~19.2.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.4",
    "vite": "^5.4.8"
  }
}
