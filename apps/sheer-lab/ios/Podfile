# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'SheerLabNative' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # x86_64 iOS Simulator workaround (Intel Macs).
    # react-native-ble-plx's MultiplatformBleAdapter (Swift) emits a back-deploy stub
    # `__swift_coroFrameAllocStub` that references the newer runtime symbol
    # `_swift_coroFrameAlloc`. The arm64 simulator linker treats that reference as weak,
    # but the x86_64 simulator linker treats it as a hard "Undefined symbol" and fails the
    # app link. `-U` lets the linker resolve it dynamically (the stub falls back to plain
    # allocation when the symbol is absent). Harmless no-op on arm64/device.
    coro_flag = '-Wl,-U,_swift_coroFrameAlloc'
    installer.aggregate_targets.each do |aggregate_target|
      project = aggregate_target.user_project
      project.native_targets.each do |native_target|
        native_target.build_configurations.each do |build_config|
          ldflags = build_config.build_settings['OTHER_LDFLAGS'] ||= ['$(inherited)']
          ldflags = build_config.build_settings['OTHER_LDFLAGS'] = [ldflags] if ldflags.is_a?(String)
          ldflags << coro_flag unless ldflags.include?(coro_flag)
        end
      end
      project.save
    end
  end
end
