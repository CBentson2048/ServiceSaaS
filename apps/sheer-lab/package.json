{
  "name": "@sheer/sheer-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Dedicated Sheer Lab staff app (React Native CLI + TypeScript) for BLE-driven formula workflows.",
  "main": "index.js",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint \"src/**/*.{ts,tsx}\" App.tsx",
    "typecheck": "tsc --noEmit",
    "prebuild": "pnpm --filter \"@sheer/domain\" --filter \"@sheer/lab-core\" --filter \"@sheer/api-client\" --filter \"@sheer/design-tokens\" --filter \"@sheer/utils\" --filter \"@sheer/auth\" run build",
    "build": "echo \"Sheer Lab native builds use React Native CLI: pnpm --filter @sheer/sheer-lab ios|android\"",
    "pods": "cd ios && pod install"
  },
  "dependencies": {
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.12",
    "@sheer/api-client": "workspace:*",
    "@sheer/auth": "workspace:*",
    "@sheer/design-tokens": "workspace:*",
    "@sheer/domain": "workspace:*",
    "@sheer/lab-core": "workspace:*",
    "@sheer/utils": "workspace:*",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-ble-plx": "^3.5.1",
    "react-native-keychain": "^10.0.0",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.23.0",
    "react-native-svg": "^15.15.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.83.6",
    "@react-native/metro-config": "0.83.6",
    "@react-native/typescript-config": "0.83.6",
    "@sheer/config": "workspace:*",
    "@types/react": "~19.2.14",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "react-native-dotenv": "^3.4.11",
    "typescript": "~5.9.3"
  }
}
