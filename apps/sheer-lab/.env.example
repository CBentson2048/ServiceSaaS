# React Native CLI env is read from process.env at build/runtime.
# Use localhost for iOS simulator, 10.0.2.2 for Android emulator.
# The app normalizes this to include the API prefix (`/api`) if omitted.
SHEER_LAB_API_URL=http://localhost:3001

# Placeholder identifiers. Update native bundle IDs/package names before release.
SHEER_LAB_ENV=development
SHEER_LAB_IOS_BUNDLE_ID=com.sheer.lab
SHEER_LAB_ANDROID_PACKAGE=com.sheer.lab
