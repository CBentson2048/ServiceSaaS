# react-native-dotenv inlines these into the JS bundle at build time.
# Restart Metro (and rebuild) after changing this file.
#
# API base URL. Leave EMPTY for the automatic build-type behaviour:
#   • development build (Metro / run-ios|run-android) → http://localhost:3001
#   • Release / Xcode "Archive"                        → Railway (production)
# Set it ONLY to override the LOCAL DEV url, e.g. your Mac's LAN IP for a physical
# device, or http://10.0.2.2:3001 for the Android emulator. The override is
# IGNORED in Release/archive builds, which always use the Railway production API.
# The value is normalized to include the `/api` prefix if omitted.
SHEER_LAB_API_URL=

# Environment label is derived from the build type (dev → development,
# Release → production). Set it only to force 'staging' during development.
SHEER_LAB_ENV=

# Placeholder identifiers. Update native bundle IDs/package names before release.
SHEER_LAB_IOS_BUNDLE_ID=com.blesheer.app
SHEER_LAB_ANDROID_PACKAGE=com.blesheer.app
