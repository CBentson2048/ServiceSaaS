# Expo client-side env must be prefixed with EXPO_PUBLIC_ to be exposed.
EXPO_PUBLIC_API_URL=http://localhost:3001

# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ZAC semantic-routing inspector (UAT / developer visibility): shows which
# request mode / analysis intent the backend routed each answer to and whether
# the semantic router or the fallback decided it. Presentation only. Unset =
# dev builds only; set true on a UAT build.
# EXPO_PUBLIC_ZAC_SHOW_ROUTING_DEBUG=true
