{
  "name": "@sheer/sheer-app",
  "version": "0.1.0",
  "private": true,
  "description": "Personal Sheer App for stylists (Expo + React Native + TypeScript).",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:localhost": "NODE_OPTIONS=--dns-result-order=ipv4first expo start --host localhost",
    "start:tunnel": "expo start --tunnel",
    "android": "NODE_OPTIONS=--dns-result-order=ipv4first expo start --android --host localhost",
    "ios": "NODE_OPTIONS=--dns-result-order=ipv4first expo start --ios --host localhost",
    "web": "expo start --web",
    "lint": "eslint \"{app,src}/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "build": "echo \"Sheer App production builds use EAS: pnpm --filter @sheer/sheer-app exec eas build\""
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.10",
    "@expo/vector-icons": "^15.1.1",
    "@sheer/design-tokens": "workspace:*",
    "@sheer/domain": "workspace:*",
    "@sheer/ui-mobile": "workspace:*",
    "@stripe/stripe-react-native": "^0.66.0",
    "expo": "~55.0.18",
    "expo-constants": "~55.0.15",
    "expo-device": "~55.0.21",
    "expo-linking": "~55.0.14",
    "expo-notifications": "~55.0.27",
    "expo-router": "~55.0.13",
    "expo-secure-store": "^55.0.13",
    "expo-splash-screen": "~55.0.19",
    "expo-status-bar": "~55.0.5",
    "expo-system-ui": "~55.0.16",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.1",
    "react-native-reanimated": "~4.2.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.23.0",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@sheer/config": "workspace:*",
    "@types/react": "~19.2.14",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "typescript": "~5.9.3"
  }
}
