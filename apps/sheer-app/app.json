{
  "expo": {
    "name": "QLOOQO",
    "slug": "qlooqo",
    "version": "1.0.0",
    "scheme": "qlooqo",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.qlooqo.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.qlooqo.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "@stripe/stripe-react-native"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b7d20bfb-5ce1-46d5-bd78-08c19eeece5d"
      }
    }
  }
}
