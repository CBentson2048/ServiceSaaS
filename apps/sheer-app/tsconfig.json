{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@sheer/design-tokens": ["../../packages/design-tokens/src/index.ts"],
      "@sheer/ui-mobile": ["../../packages/ui-mobile/src/index.tsx"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
